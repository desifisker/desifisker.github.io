@inproceedings{fisker2025uavsee,
  abbr = {IROS},
  title = {UAV See, UGV Do: Aerial Imagery and Virtual Teach Enabling Zero-Shot Ground Vehicle Repeat},
  author = {Fisker, Desiree and Krawciw, Alexander and Lilge, Sven and Greeff, Melissa and Barfoot, Timothy D.},
  booktitle = {2025 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)},
  year = {2025},
  pages = {17518--17525},
  doi = {10.1109/IROS60139.2025.11247387},
  arxiv = {2505.16912},
  html = {https://arxiv.org/html/2505.16912},
  pdf = {fisker-uav-see-ugv-do-iros-2025.pdf},
  preview = {uav-see-ugv-do.png},
  video = {/assets/video/uav-see-ugv-do-video.mp4},
  selected = {true},
  bibtex_show = {true},
  abstract = {This paper presents Virtual Teach and Repeat (VirT&R), an extension of the Teach and Repeat framework that enables GPS-denied, zero-shot autonomous ground vehicle navigation in untraversed environments. The method uses aerial imagery to train a Neural Radiance Field, extracts dense point clouds and photo-textured meshes, virtually teaches a desired UGV path in simulation, and then executes the route in the physical environment with LiDAR Teach and Repeat.}
}

